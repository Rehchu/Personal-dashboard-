{
  // Personal Dashboard — Cloudflare Worker (static assets only).
  // Deploy:  npm install && npx wrangler deploy
  // (first time: npx wrangler login)
  // Local dev: npx wrangler dev
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deploys OVER the existing "lifehq" Worker — this dashboard replaces the
  // old LifeHQ app at https://lifehq.dyer-hq.workers.dev
  "name": "lifehq",
  "compatibility_date": "2026-08-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // every request goes through the Worker so the login gate covers the app
    "run_worker_first": ["/*"]
  },
  // Private media storage (background video), streamed only to a signed-in session
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "lifehq-media"
    }
  ],
  // Cross-device sync storage (created via the Cloudflare connector)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifehq-sync",
      "database_id": "cca6b146-1962-4c62-9354-a2571103744a",
      "migrations_dir": "migrations"
    }
  ]
}
